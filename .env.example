# =============================================================
# DSP AI Investment Intelligence Platform
# Environment Configuration
# =============================================================
# IMPORTANT: Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# =============================================================

# --- Application ---
APP_NAME=DSP AI Investment Intelligence
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
APP_SECRET_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dsp_user:dsp_password@localhost:5432/dsp_investment
DATABASE_SYNC_URL=postgresql://dsp_user:dsp_password@localhost:5432/dsp_investment
POSTGRES_USER=dsp_user
POSTGRES_PASSWORD=dsp_password
POSTGRES_DB=dsp_investment

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- Market Data Provider ---
# Options: demo, real, yfinance, finance_api
MARKET_DATA_PROVIDER=real
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_BASE_URL=

# --- Finance Analytics API (Configure locally in .env — NEVER commit credentials) ---
FINANCE_API_KEY=
FINANCE_API_BASE_URL=
FINANCE_API_ENVIRONMENT=production

# --- NSE/BSE API (when using official data feeds) ---
NSE_API_KEY=
NSE_API_SECRET=
BSE_API_KEY=
BSE_API_SECRET=

# --- LLM Provider ---
# Options: openai, azure_openai, anthropic, google
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Embedding Model ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=dsp_documents

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=dsp_investment_models

# --- Object Storage (S3-compatible) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=dsp-investment-platform
S3_ENDPOINT_URL=

# --- Authentication ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Airflow ---
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql://dsp_user:dsp_password@localhost:5432/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=

# --- Monitoring ---
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Demo Mode ---
DEMO_MODE=true
