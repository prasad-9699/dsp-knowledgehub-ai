# ==============================================================================
# DSP KnowledgeHub AI — Production Cloud Environment Variables
# Copy to cloud provider secrets (Render / Railway / AWS Secrets Manager)
# ==============================================================================

# --- Application Core ---
APP_NAME=DSP KnowledgeHub AI
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
APP_HOST=0.0.0.0
APP_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_HEX_64_CHARS

# --- Web & CORS ---
# Must match your deployed frontend URL (e.g. https://dsp-knowledgehub.vercel.app)
FRONTEND_URL=https://dsp-knowledgehub.vercel.app
CORS_ORIGINS=https://dsp-knowledgehub.vercel.app,http://localhost:5173

# --- Database (PostgreSQL) ---
# Provided by managed PostgreSQL (Render Postgres, Neon, AWS RDS, Supabase)
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require
DATABASE_SYNC_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require

# --- Authentication & JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_SECURE_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI & Vector Store (Qdrant Cloud) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-proj-your-openai-api-key
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-proj-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small

QDRANT_URL=https://your-cluster-url.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=dsp_documents

# --- Operational Flags ---
DEMO_MODE=true
LOG_LEVEL=INFO
LOG_FORMAT=json
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=3000

